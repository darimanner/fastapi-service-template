[project]
name = "{{ project_name }}"
version = "0.1.0"
description = {{ description | tojson }}
authors = [{ name = {{ author_name | tojson }}, email = {{ author_email | tojson }} }]
readme = "README.md"
requires-python = ">=3.14"
dependencies = [
    "fastapi[standard]>=0.159.1",
    "pydantic-settings>=2.16.1",
    "structlog>=26.1.0",
]

[dependency-groups]
dev = [
    "mypy>=2.4.1",
    "pre-commit>=4.7.0",
    "pytest>=9.1.1",
    "ruff>=0.17.1",
]

[tool.pytest.ini_options]
pythonpath = ["."]
testpaths = ["tests"]

[tool.mypy]
strict = true
files = ["src", "tests"]
plugins = ["pydantic.mypy"]

[tool.ruff]
line-length = 90

[tool.ruff.lint]
preview = true
explicit-preview-rules = true
select = [
    "E",
    "F",
    "B",
    "I",
    "UP",
    "S",
    "C90",
    "N",
    "ANN",
    "ASYNC",
    "T20",
    "RUF",
    "PTH",
    "ERA",
    "PGH",
    "PL",
    "PLR0904",
    "PLR0914",
    "PLR0916",
    "PLR1702",
]
ignore = ["ANN401", "S104"]

[tool.ruff.lint.per-file-ignores]
"**/__init__.py" = ["F401"]
"tests/**" = ["S101", "PLR2004"]

[tool.ruff.lint.mccabe]
max-complexity = 8

[tool.ruff.lint.pylint]
max-branches = 8
max-returns = 4
max-statements = 30
max-public-methods = 10
max-locals = 10
max-nested-blocks = 3
max-bool-expr = 3

[tool.ruff.lint.isort]
combine-as-imports = true
force-sort-within-sections = true
known-first-party = ["src"]
