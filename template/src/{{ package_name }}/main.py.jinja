from collections.abc import AsyncGenerator
from contextlib import asynccontextmanager

from fastapi import FastAPI

from {{ package_name }}.api import health
from {{ package_name }}.config.settings import settings
from {{ package_name }}.core.db.sessions import engine
from {{ package_name }}.core.exceptions.handlers import register_exception_handlers
from {{ package_name }}.core.observability.logging import setup_logging
from {{ package_name }}.core.observability.middleware import request_context


@asynccontextmanager
async def lifespan(_: FastAPI) -> AsyncGenerator[None]:
    yield
    await engine.dispose()


def create_app() -> FastAPI:
    setup_logging(settings.logger.level, debug=settings.logger.debug)
    app = FastAPI(title=settings.app.name, lifespan=lifespan)
    app.middleware("http")(request_context)
    register_exception_handlers(app)
    app.include_router(health.router)
    return app


app = create_app()
