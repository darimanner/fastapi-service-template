from fastapi.testclient import TestClient

from {{ package_name }}.core.observability.logging import mask_secrets
from {{ package_name }}.main import app

client = TestClient(app)


def test_request_id_is_echoed() -> None:
    response = client.get("/health/live", headers={"X-Request-ID": "abc"})

    assert response.headers["X-Request-ID"] == "abc"


def test_request_id_is_generated() -> None:
    assert client.get("/health/live").headers["X-Request-ID"]


def test_malformed_request_id_is_replaced() -> None:
    response = client.get("/health/live", headers={"X-Request-ID": "a b" + "x" * 100})

    assert len(response.headers["X-Request-ID"]) == 32


def test_mask_secrets() -> None:
    event = mask_secrets(None, "info", {"Password": "p", "api_key_id": "k", "user": "u"})

    assert event == {"Password": "***", "api_key_id": "***", "user": "u"}
